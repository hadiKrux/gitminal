{
  "name": "@im4all/gitminal",
  "version": "0.1.0",
  "description": "A keyboard-first terminal git client.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gitminal": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/im4aLL/gitminal.git"
  },
  "homepage": "https://github.com/im4aLL/gitminal#readme",
  "bugs": {
    "url": "https://github.com/im4aLL/gitminal/issues"
  },
  "keywords": [
    "git",
    "tui",
    "terminal",
    "cli",
    "opentui",
    "gitclient",
    "gitui",
    "gitminal",
    "gitterminal"
  ],
  "author": "Md Habibullah Al Hadi",
  "scripts": {
    "preview": "bun run src/index.tsx",
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build --target=bun --packages=external --banner='#!/usr/bin/env bun' --outfile=dist/index.js src/index.tsx",
    "prepublishOnly": "bun run check:all && bun run build",
    "test": "bun test --timeout 10000 --path-ignore-patterns='**/*.integration.test.ts'",
    "test:integration": "bun test --timeout 60000 integration.test",
    "test:all": "bun test --timeout 60000",
    "typecheck": "tsc --noEmit",
    "audit": "fallow audit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check . && bun run check:boundary && bun run check:glyph && bun run check:structure",
    "check:fix": "biome check --write .",
    "check:all": "bun run check && bun run typecheck && bun run test",
    "check:boundary": "bun scripts/check-boundary.ts",
    "check:glyph": "bun scripts/check-glyph.ts",
    "check:structure": "bun scripts/check-structure.ts",
    "prepare": "bunx husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/bun": "1.3.14",
    "@types/react": "^19.2.0",
    "fallow": "^3.34.1",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@opentui/core": "^0.6.6",
    "@opentui/react": "^0.6.6",
    "react": "^19.2.8"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
