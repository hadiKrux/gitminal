{
  "name": "@im4all/gitminal",
  "version": "0.1.0",
  "description": "A keyboard-first terminal git client.",
  "module": "src/index.tsx",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/im4aLL/gitminal.git"
  },
  "homepage": "https://github.com/im4aLL/gitminal#readme",
  "bugs": {
    "url": "https://github.com/im4aLL/gitminal/issues"
  },
  "keywords": [
    "git",
    "tui",
    "terminal",
    "cli",
    "opentui"
  ],
  "author": "Md Habibullah Al Hadi",
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "test": "bun test --timeout 10000 --path-ignore-patterns='**/*.integration.test.ts'",
    "test:integration": "bun test --timeout 60000 '**/*.integration.test.ts'",
    "test:all": "bun test --timeout 60000",
    "typecheck": "tsc --noEmit",
    "audit": "fallow audit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/bun": "1.3.14",
    "fallow": "^3.34.1",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@opentui/core": "^0.6.6",
    "@opentui/react": "^0.6.6",
    "react": "^19.2.8"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
